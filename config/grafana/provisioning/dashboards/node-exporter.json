{
  "id": null,
  "uid": "node-exporter-host",
  "title": "Node Exporter - Host Metrics",
  "tags": ["linux", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage %",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}]}}},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 8},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Memory Usage %",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}]}}},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 8},
      "targets": [{"expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100", "legendFormat": "Memory %", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Disk Usage %",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 100, "unit": "percent", "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}]}}},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
      "targets": [{"expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "Disk %", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Network I/O",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{device!~\"lo\"}[5m])", "legendFormat": "Rx {{device}}", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total{device!~\"lo\"}[5m])", "legendFormat": "Tx {{device}}", "refId": "B"}
      ]
    }
  ]
}
