# Headscale configuration — auto-generated by homelab-toolkit (schema: v0.29)
# https://headscale.net/stable/ref/configuration/

server_url: https://vpn.{{ domain }}

listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: false

# Unix socket in the writable data volume (container is read_only; non-root user).
unix_socket: /var/lib/headscale/headscale.sock
unix_socket_permission: "0770"

# Headscale generates and persists its own noise key in the data volume.
noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: {{ mesh_ipv4_cidr }}
  v6: {{ mesh_ipv6_cidr }}
  allocation: sequential

# Use Tailscale's public DERP relays for NAT traversal (no self-hosted DERP).
derp:
  server:
    enabled: false
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  paths: []
  auto_update_enabled: true
  update_frequency: 3h

node:
  ephemeral:
    inactivity_timeout: 30m

database:
  type: sqlite
  debug: false
  gorm:
    prepare_stmt: true
    parameterized_queries: true
    skip_err_record_not_found: true
    slow_threshold: 1000
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true
    wal_autocheckpoint: 1000

# OIDC authentication via Authelia — first OIDC user becomes the owner.
oidc:
  only_start_if_oidc_is_available: true
  issuer: "{{ oidc_issuer }}"
  client_id: "{{ oidc_client_id }}"
  client_secret: "{{ oidc_client_secret }}"
  scope: ["openid", "profile", "email", "groups"]
  allowed_domains:
    - {{ domain }}
  email_verified_required: false
  pkce:
    enabled: true
    method: S256

# MagicDNS resolves mesh peer hostnames as <node>.mesh.{{ domain }}. All fleet
# nodes and LXCs use --accept-dns=false so systemd-resolved → AdGuard stays the
# single source of truth for DNS; this block only affects nodes that join
# without the flag (e.g. manual `tailscale up`). Global nameservers point at
# AdGuard so even those nodes resolve internal FQDNs correctly.
dns:
  magic_dns: true
  base_domain: mesh.{{ domain }}
  override_local_dns: true
  nameservers:
    global:
      - {{ infra_dns_ip }}
      - 1.1.1.1
  search_domains: []
  extra_records: []

log:
  level: info
  format: text

# ACL for mesh tags (fleet external nodes use tag:fleet-external from config.yaml → fleet.headscale_tags).
policy:
  mode: file
  path: /etc/headscale/acl.hujson
