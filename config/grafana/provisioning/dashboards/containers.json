{
  "id": null,
  "uid": "cadvisor-containers",
  "title": "Containers - Resource Usage",
  "tags": ["docker", "cadvisor"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) by (name) * 100", "legendFormat": "{{name}}", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [{"expr": "container_memory_usage_bytes{name!=\"\"}", "legendFormat": "{{name}}", "refId": "A"}]
    }
  ]
}
