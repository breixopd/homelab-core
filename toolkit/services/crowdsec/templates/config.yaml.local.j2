{# CrowdSec LAPI auto-registration policy. Generated by the service plugin. #}
api:
  server:
    auto_registration:
      enabled: {{ crowdsec_auto_registration | lower }}
{% if crowdsec_auto_registration %}
      token: {{ crowdsec_agent_token | tojson }}
      allowed_ranges:
{% for source_range in crowdsec_agent_ranges %}
      - {{ source_range | tojson }}
{% endfor %}
{% endif %}
