# ──────────────────────────────────────────────────────────────────────────────
# Infra VM environment variables (example)
# Copy to config/proxmox/infra.env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Caddy (reverse proxy + TLS)
BASE_DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Authelia (SSO + 2FA)
AUTHELIA_ISSUER=https://auth.example.com
AUTHELIA_URL=https://auth.example.com
AUTHELIA_INTERNAL_URL=http://authelia:9091
AUTHELIA_JWT_SECRET=<generate: openssl rand -hex 32>
AUTHELIA_SESSION_SECRET=<generate: openssl rand -hex 32>
AUTHELIA_STORAGE_KEY=<generate: openssl rand -hex 32>

# Postgres (shared database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=homelab
POSTGRES_PASSWORD=<your-strong-password>
POSTGRES_DB=homelab

# Komodo (fleet Docker management)
