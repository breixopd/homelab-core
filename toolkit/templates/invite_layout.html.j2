<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Homelab invite{% endblock %}</title>
  <style>
    body { font-family: system-ui, sans-serif; line-height: 1.5; color: #1a1a1a; max-width: 640px; margin: 0 auto; padding: 1.5rem; }
    a { color: #2563eb; }
    .btn { display: inline-block; background: #2563eb; color: #fff !important; padding: 0.65rem 1.2rem; border-radius: 8px; text-decoration: none; font-weight: 600; }
    .muted { color: #666; font-size: 0.9rem; }
    h2 { font-size: 1.05rem; margin-top: 1.5rem; }
    ul { padding-left: 1.2rem; }
    li { margin-bottom: 0.85rem; }
  </style>
</head>
<body>
{% block content %}{% endblock %}
</body>
</html>
