# ──────────────────────────────────────────────────────────────────────────────
# Media VM environment variables (example)
# Copy to config/proxmox/media.env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Jellyfin (media streaming)
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=<get-from-jellyfin-dashboard>

# Sonarr (TV automation)
SONARR_API_KEY=<auto-generated-or-your-own>
SONARR_URL=https://sonarr.example.com

# Radarr (movie automation)
RADARR_API_KEY=<auto-generated-or-your-own>
RADARR_URL=https://radarr.example.com

# qBittorrent (BitTorrent client)
QBITTORRENT_PORT_BIND=6881
QBITTORRENT_URL=https://qbt.example.com

# Prowlarr (indexer manager)
PROWLARR_API_KEY=<auto-generated-or-your-own>

# Seerr (media requests — Jellyfin + Plex + Emby)
SEERR_API_KEY=<auto-generated-or-your-own>

# Tautulli (Plex monitoring)
TAUTULLI_API_KEY=<auto-generated-or-your-own>

# Gluetun VPN (for downloads)
VPN_ENABLED=true
VPN_PROVIDER=protonvpn
VPN_USER=<your-vpn-username>
VPN_PASSWORD=<your-vpn-password>
