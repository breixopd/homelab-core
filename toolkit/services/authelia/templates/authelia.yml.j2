# Auto-generated by toolkit
theme: dark
server:
  address: 'tcp://:9091'

log:
  level: info

totp:
  issuer: {{ domain }}

authentication_backend:
  ldap:
    implementation: 'lldap'
    address: '{{ lldap_url }}'
    base_dn: '{{ lldap_base_dn }}'
    users_filter: '(&(|({username_attribute}={input})({mail_attribute}={input}))(objectClass=person))'
    groups_filter: '(&(member={dn})(objectClass=groupOfNames))'
    user: 'cn=ldap-bind,ou=people,{{ lldap_base_dn }}'
    password: '{{ lldap_bind_password }}'

  password_reset:
    disable: false
  password_change:
    disable: false

access_control:
  default_policy: deny
  rules:
{% for rule in access_rules %}
    - domain: '{{ rule.domain }}'
      policy: '{{ rule.policy }}'
{% if rule.get('subjects') %}
      subject:
{% for subject in rule.subjects %}
        - '{{ subject }}'
{% endfor %}
{% endif %}
{% endfor %}

session:
  cookies:
    - domain: '{{ domain }}'
      authelia_url: 'https://auth.{{ domain }}'

storage:
  postgres:
    address: 'tcp://{{ postgres_host }}:{{ postgres_port }}'
    database: authelia
    username: authelia

notifier:
  disable_startup_check: true
{% if smtp_address %}
  smtp:
    address: 'smtp://{{ smtp_address }}'
    timeout: '15s'
    sender: 'Authelia <authelia@{{ domain }}>'
    identifier: 'auth.{{ domain }}'
    # Docker-Mailserver is TLS-disabled internally; this traffic stays on the
    # dedicated Authelia-to-mailserver bridge and never crosses a host network.
    disable_require_tls: true
{% else %}
  filesystem:
    filename: /config/notification.txt
{% endif %}

identity_providers:
  oidc:
    hmac_secret: '{{ oidc_hmac_secret }}'
    jwks:
      - key: |
{{ jwks_pem | indent(10, first=True) }}
    claims_policies:
      homelab_default:
        id_token:
          - email
          - email_verified
          - groups
          - preferred_username
          - name
        access_token:
          - groups
          - email
          - preferred_username
          - name
      vaultwarden:
        id_token:
          - vaultwarden_roles
        custom_claims:
          vaultwarden_roles:
            attribute: 'vaultwarden_roles'
      nextcloud_userinfo:
        custom_claims:
          is_nextcloud_admin: {}
    scopes:
      vaultwarden:
        claims:
          - vaultwarden_roles
      nextcloud_userinfo:
        claims:
          - is_nextcloud_admin
    clients:
{% for client in oidc_clients %}
      - client_id: '{{ client.client_id }}'
        client_name: '{{ client.name }}'
        client_secret: '{{ client.secret_hash }}'
        public: {{ client.public | lower }}
        authorization_policy: '{{ client.authorization_policy }}'
        claims_policy: '{{ client.claims_policy }}'
        require_pkce: {{ client.require_pkce | lower }}
        pkce_challenge_method: '{{ client.pkce_challenge_method }}'
        redirect_uris:
{% for uri in client.redirect_uris %}
          - '{{ uri }}'
{% endfor %}
        scopes:
{% for scope in client.scopes %}
          - '{{ scope }}'
{% endfor %}
        response_types:
{% for response_type in client.response_types %}
          - '{{ response_type }}'
{% endfor %}
        grant_types:
{% for grant_type in client.grant_types %}
          - '{{ grant_type }}'
{% endfor %}
        access_token_signed_response_alg: '{{ client.access_token_signed_response_alg }}'
        userinfo_signed_response_alg: '{{ client.userinfo_signed_response_alg }}'
        token_endpoint_auth_method: '{{ client.token_endpoint_auth_method }}'
{% endfor %}

definitions:
  user_attributes:
    vaultwarden_roles:
      expression: '{{ admin_group_expression }} ? ["admin"] : ["user"]'
    is_nextcloud_admin:
      expression: '{{ admin_group_expression }}'
