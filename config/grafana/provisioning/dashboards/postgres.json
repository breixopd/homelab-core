{
  "id": null,
  "uid": "postgres-overview",
  "title": "PostgreSQL Overview",
  "tags": ["postgres", "database"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "pg_stat_activity_count{state=\"active\"}", "legendFormat": "Active", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Database Size",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "pg_database_size_bytes", "legendFormat": "{{datname}}", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Transactions/sec",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [
        {"expr": "rate(pg_stat_database_xact_commit{datname!=\"template0\",datname!=\"template1\",datname!=\"postgres\"}[5m])", "legendFormat": "commits {{datname}}", "refId": "A"},
        {"expr": "rate(pg_stat_database_xact_rollback{datname!=\"template0\",datname!=\"template1\",datname!=\"postgres\"}[5m])", "legendFormat": "rollbacks {{datname}}", "refId": "B"}
      ]
    }
  ]
}
