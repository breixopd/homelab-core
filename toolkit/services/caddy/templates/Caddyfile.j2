# Auto-generated by toolkit; edit the owning service manifest instead.
{
{% if email %}	email {{ email }}
{% endif %}
{% if acme_ca %}	acme_ca {{ acme_ca }}
{% endif %}
{% if dns_challenge %}	acme_dns cloudflare {env.CF_API_TOKEN}
{% endif %}
{% if crowdsec_enabled and cloudflare_proxy_enabled %}
	servers {
		trusted_proxies static{% for cidr in cloudflare_proxy_cidrs %} {{ cidr }}{% endfor %}{{ '\n\t\t' }}trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
{% endif %}
{% if crowdsec_enabled %}
	crowdsec {
		api_url {{ crowdsec_url }}
		api_key {env.CADDY_BOUNCER_API_KEY}
		ticker_interval 15s
		enable_hard_fails
	}
{% endif %}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		>Cache-Control "no-transform"
		-Server
	}
}

(compression) {
	encode zstd gzip
}

(authelia) {
	forward_auth {{ authelia_url }} {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
}

{% if dns_challenge %}
*.{{ domain }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	respond 404
}
{% endif %}

{% for site in routes %}
{{ site.host }} {
	import security_headers
	import compression
{% if site.exposure == 'public' and crowdsec_enabled %}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			request>uri regexp "\\?.*" ""
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
		}
	}
{% endif %}
{% if site.allowed_remote_cidrs %}
	@outside_mesh not remote_ip {{ site.allowed_remote_cidrs | join(' ') }}
{% endif %}
{% for handler in site.handlers if handler.kind != 'default' %}
	@route_{{ loop.index }} path{% for path in handler.paths %} {{ path }}{% if handler.kind == 'prefix' %}*{% endif %}{% endfor %}{{ '\n' -}}
{% endfor %}
	route {
{% if site.allowed_remote_cidrs %}
		respond @outside_mesh {{ site.reject_untrusted_status }}
{% endif %}
{% for header in site.identity_request_headers %}
		request_header -{{ header }}
{% endfor %}
{% if site.request_body_max_mb %}
		request_body {
			max_size {{ site.request_body_max_mb }}MB
		}
{% endif %}
{% for header in site.response_headers %}
		header >{{ header.name }} "{{ header.value | caddy_escape }}"
{% endfor %}
{% for handler in site.handlers %}
{% if loop.first and site.exposure == 'public' and crowdsec_enabled %}
		crowdsec
{% endif %}
{% if handler.kind == 'default' %}
		handle {
{% else %}
		handle @route_{{ loop.index }} {
{% endif %}
{% if handler.respond_status %}
			respond {{ handler.respond_status }}
{% elif handler.response_body %}
			respond "{{ handler.response_body | caddy_escape }}" 200
{% else %}
{% if handler.auth_mode == 'forward_auth' %}
			import authelia
{% endif %}
{% if handler.file_server_root %}
			root * {{ handler.file_server_root }}
			file_server
{% else %}
			reverse_proxy {{ handler.upstream }} {
				header_up X-Real-IP {remote_host}
			}
{% endif %}
{% endif %}
		}
{% endfor %}
	}
}

{% endfor %}
