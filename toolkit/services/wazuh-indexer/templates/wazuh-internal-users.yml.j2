---
# OpenSearch Security internal users — auto-generated by homelab-toolkit.
# admin/kibanaserver hashes are derived from WAZUH_INDEXER_PASSWORD /
# WAZUH_DASHBOARD_PASSWORD so the security index initialises with real passwords.
_meta:
  type: "internalusers"
  config_version: 2

admin:
  hash: "{{ admin_hash }}"
  reserved: true
  backend_roles:
    - "admin"
  description: "Homelab admin user"

kibanaserver:
  hash: "{{ kibanaserver_hash }}"
  reserved: true
  description: "Wazuh dashboard service user"
